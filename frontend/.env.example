# Point the frontend at a specific API origin.
# Leave this UNSET in development: the app then calls same-origin `/api`,
# which the Vite dev/preview server proxies to http://127.0.0.1:8000 .
#
# VITE_API_URL=http://localhost:8000

# Where `vite dev` / `vite preview` forwards `/api/*` (default shown).
# VITE_PROXY_TARGET=http://127.0.0.1:8000
