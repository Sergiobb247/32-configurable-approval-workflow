# Copy to backend/.env for local development. NEVER commit a real .env.
# Contract: docs/technical-spec.md section 9. `app/config.py` is the ONLY
# place these are read.

ENV=development

# Local default (SQLite file created on startup).
# Production example: postgresql://user:password@host:5432/approvals
DATABASE_URL=sqlite:///./app.db

# Required outside development. Generate a long random value, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-change-me-at-least-32-characters

ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# Comma-separated exact frontend origins. Never "*".
CORS_ORIGINS=http://localhost:5173
